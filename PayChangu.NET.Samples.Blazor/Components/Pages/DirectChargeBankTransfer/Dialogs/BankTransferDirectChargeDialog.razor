@if (isLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-p-4">
        <RadzenText TextStyle="TextStyle.Body1">Sending payment request to PayChangu...</RadzenText>
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
    </RadzenStack>
}
else if (!string.IsNullOrWhiteSpace(chargeId))
{
    <RadzenStack Gap="0.75rem">
        <RadzenAlert AlertStyle="AlertStyle.Info">
            The Direct Charge request was accepted. This does not mean the customer has completed payment.
            Verify the transaction or process its webhook before fulfilling an order.
        </RadzenAlert>
        <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">@chargeId</RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2">Provider reference</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">@providerReference</RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2">Current status</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">@paymentStatus</RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2">Payment instructions</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">@paymentInstructions</RadzenText>
        <a href="/direct-charge/bank-transfer/details?charge_id=@chargeId">Open Single Transaction</a>
        <a href="/verify-transactions">Open Verify Transactions</a>
    </RadzenStack>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
}

@code {
    [Parameter] public InitiateBankTransferDirectChargeRequest Request { get; set; } = default!;

    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;

    private string? chargeId;
    private string? providerReference;
    private string? paymentStatus;
    private string? paymentInstructions;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await InitiateBankTransferAsync();
    }

    private async Task InitiateBankTransferAsync()
    {
        try
        {
            var response = await payChanguClient.DirectCharges.BankTransfer.InitiateAsync(Request);

            if (!response.Success || response.Result?.Data is not { } data)
            {
                errorMessage = response.ErrorMessage ??
                    "PayChangu could not initiate the Bank Transfer Direct Charge.";
                return;
            }

            chargeId = data.Transaction.ChargeId;
            providerReference = data.Transaction.ReferenceId;
            paymentStatus = data.Transaction.Status;
            paymentInstructions = $"{data.PaymentAccountDetails.BankName} — " +
                                  $"Account: {data.PaymentAccountDetails.AccountNumber}; " +
                                  $"Name: {data.PaymentAccountDetails.AccountName}";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to connect to PayChangu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
