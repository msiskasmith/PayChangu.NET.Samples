@page "/direct-charge/bank-transfer/details"

<PageTitle>Single Transaction | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Single Transaction</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Retrieve a Bank Transfer Direct Charge transaction using its charge identifier.
        </RadzenText>
    </div>
    <RadzenCard>
        <RadzenTemplateForm TItem="TransactionLookupRequest" Data="@request" Submit="@OpenDetailsDialogAsync">
            <RadzenStack Gap="1rem">
                <div>
                    <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
                    <RadzenTextBox Name="ChargeId" @bind-Value="request.ChargeId"
                                   Placeholder="Enter charge ID" Style="width: 100%" />
                    <RadzenRequiredValidator Component="ChargeId" Text="Enter a charge identifier." />
                </div>
                <RadzenButton Text="Get transaction" Icon="search" ButtonType="ButtonType.Submit" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "charge_id")]
    public string? ChargeId { get; set; }

    private readonly TransactionLookupRequest request = new();

    protected override void OnParametersSet() => request.ChargeId = ChargeId ?? string.Empty;

    private async Task OpenDetailsDialogAsync(TransactionLookupRequest model)
    {
        await DialogService.OpenAsync<SingleBankTransferTransactionDetailsDialog>(
            "Single Bank Transfer Transaction",
            new Dictionary<string, object?>
            {
                { nameof(SingleBankTransferTransactionDetailsDialog.ChargeId), model.ChargeId.Trim() }
            },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });
    }

    public sealed class TransactionLookupRequest
    {
        public string ChargeId { get; set; } = string.Empty;
    }
}
