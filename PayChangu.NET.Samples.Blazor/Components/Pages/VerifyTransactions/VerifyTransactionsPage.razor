@page "/verify-transactions"
@page "/transactions"

<PageTitle>Verify Transactions | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Verify Transactions</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Verify a payment using its transaction reference or charge identifier.
        </RadzenText>
    </div>
    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText>Enter the transaction details in the verification dialog. Checkout uses the merchant transaction reference; Direct Charge uses the PayChangu charge identifier.</RadzenText>
            <RadzenButton Text="Verify transaction" Icon="search" Click="@OpenVerificationDialogAsync" />
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;

    private async Task OpenVerificationDialogAsync()
    {
        await DialogService.OpenAsync<VerifyTransactionDialog>(
            "Verify Transaction",
            options: new DialogOptions { Width = "650px", CloseDialogOnOverlayClick = false });
    }
}