@using Bogus

@page "/payouts/bank"

<PageTitle>Bank Payout | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Bank Payout</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">Send funds to a supported bank account.</RadzenText>
    </div>

    <RadzenCard>
        <RadzenTemplateForm TItem="InitiateBankPayoutRequest" Data="@Request" Submit="@InitiatePayoutAsync">
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                        <RadzenNumeric Name="Amount" TValue="decimal" @bind-Value="Request.Amount" Min="1" Format="N2" Style="width: 100%" />
                        <RadzenNumericRangeValidator Component="Amount" Min="1" Text="Enter an amount greater than zero." />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                        <RadzenDropDown Name="Currency" TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency"
                                        Change="@OnCurrencyChanged" Style="width: 100%" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenText TextStyle="TextStyle.Subtitle2">Bank or payout provider</RadzenText>
                <a href="/payouts/banks">View supported banks</a>
                <RadzenDropDown Name="BankId" TValue="Guid" Data="@supportedBanks" TextProperty="Name" ValueProperty="Id"
                                @bind-Value="Request.BankId" Placeholder="Select a bank or provider"
                                Disabled="@isLoadingReferenceData" Style="width: 100%" />
                <RadzenRequiredValidator Component="BankId" DefaultValue="@Guid.Empty" Text="Select a bank or payout provider." />
                @if (isLoadingReferenceData)
                {
                    <RadzenText TextStyle="TextStyle.Caption">Loading supported banks...</RadzenText>
                }
                else if (!string.IsNullOrWhiteSpace(referenceDataError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning">@referenceDataError</RadzenAlert>
                }

                <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Recipient account</RadzenText>
                    <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" ButtonType="ButtonType.Button" Click="@GenerateTestDetails" />
                </div>
                <RadzenTextBox Name="BankAccountName" @bind-Value="Request.BankAccountName" Placeholder="Recipient account name" Style="width: 100%" />
                <RadzenRequiredValidator Component="BankAccountName" Text="Enter the recipient account name." />
                <RadzenTextBox Name="BankAccountNumber" @bind-Value="Request.BankAccountNumber" Placeholder="Recipient account number" Style="width: 100%" />
                <RadzenRequiredValidator Component="BankAccountNumber" Text="Enter the recipient account number." />

                <RadzenText TextStyle="TextStyle.Subtitle2">Recipient details (optional)</RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="Request.FirstName" Placeholder="First name" Style="width: 100%" /></RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="Request.LastName" Placeholder="Last name" Style="width: 100%" /></RadzenColumn>
                    <RadzenColumn Size="12">
                        <RadzenTextBox Name="Email" @bind-Value="Request.Email" Placeholder="Email address" Style="width: 100%" />
                        <RadzenEmailValidator Component="Email" Text="Enter a valid email address." />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenButton Text="Initiate bank payout" Icon="send" ButtonType="ButtonType.Submit" Disabled="@isLoadingReferenceData" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private IPayChanguClient payChanguClient { get; set; } = default!;
    [Inject] private DialogService dialogService { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly List<SupportedBank> supportedBanks = [];
    private InitiateBankPayoutRequest Request { get; set; } = new() { Amount = 5000m };
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private string? referenceDataError;
    private bool isLoadingReferenceData;

    protected override async Task OnInitializedAsync()
    {
        await LoadSupportedBanksAsync();
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        Request.FirstName = faker.Name.FirstName();
        Request.LastName = faker.Name.LastName();
        Request.Email = faker.Internet.Email();
        Request.BankAccountName = faker.Name.FullName();
        Request.BankAccountNumber = faker.Random.ReplaceNumbers("##########");
    }

    private async Task OnCurrencyChanged(object value)
    {
        currency = (PayChanguCurrency)value;
        await LoadSupportedBanksAsync();
    }

    private async Task LoadSupportedBanksAsync()
    {
        isLoadingReferenceData = true;
        referenceDataError = null;
        try
        {
            var response = await payChanguClient.ReferenceData.Banks.GetSupportedAsync(currency);
            if (response.Success && response.Result?.Data is { } banks)
            {
                supportedBanks.Clear();
                supportedBanks.AddRange(banks);
                if (!supportedBanks.Any(x => x.Id == Request.BankId))
                {
                    Request.BankId = supportedBanks.FirstOrDefault()?.Id ?? Guid.Empty;
                }
            }
            else
            {
                referenceDataError = response.ErrorMessage ?? $"Unable to retrieve supported banks for {currency}.";
            }
        }
        catch (HttpRequestException ex)
        {
            referenceDataError = $"Unable to retrieve supported banks: {ex.Message}";
        }
        finally
        {
            isLoadingReferenceData = false;
        }
    }

    private async Task InitiatePayoutAsync(InitiateBankPayoutRequest request)
    {
        Request.ChargeId = Guid.CreateVersion7().ToString();
        await dialogService.OpenAsync<BankPayoutDialog>(
            "Initiate Bank Payout",
            new Dictionary<string, object?> { { nameof(BankPayoutDialog.Request), Request } },
            new DialogOptions { Width = "600px" });

        GenerateTestDetails();
    }
}
