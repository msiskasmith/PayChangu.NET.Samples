<RadzenTemplateForm TItem="PayoutLookupRequest" Data="@request" Submit="@GetDetailsAsync">
    <RadzenStack Gap="1rem">
        <div>
            <RadzenText TextStyle="TextStyle.Subtitle2">Payout charge identifier</RadzenText>
            <RadzenTextBox Name="ChargeId" @bind-Value="request.ChargeId" Placeholder="Enter payout charge ID" Style="width: 100%" />
            <RadzenRequiredValidator Component="ChargeId" Text="Enter a payout charge identifier." />
        </div>
        <RadzenButton Text="Get payout details" Icon="search" ButtonType="ButtonType.Submit" Disabled="@isLoading" />
        @if (isLoading)
        {
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-p-4">
                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
                <RadzenText>Retrieving bank payout details...</RadzenText>
            </RadzenStack>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
        }
        @if (transaction is not null)
        {
            <RadzenDivider />
            <RadzenText TextStyle="TextStyle.H6">Payout details</RadzenText>
            <RadzenText>Charge ID: @transaction.ChargeId</RadzenText>
            <RadzenText>Reference: @transaction.ReferenceId</RadzenText>
            <RadzenText>Status: @transaction.Status</RadzenText>
            <RadzenText>Amount: @transaction.Currency @transaction.Amount.ToString("N2")</RadzenText>
            <RadzenText>Recipient: @transaction.RecipientAccountDetails.AccountName</RadzenText>
            <RadzenText>Account: @transaction.RecipientAccountDetails.AccountNumber</RadzenText>
            <RadzenText>Bank: @transaction.RecipientAccountDetails.BankName</RadzenText>
            <RadzenText>Created: @transaction.CreatedAt.ToLocalTime().ToString("g")</RadzenText>
            <RadzenText>Completed: @(transaction.CompletedAt?.ToLocalTime().ToString("g") ?? "Not completed")</RadzenText>
        }
        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="@Close" />
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public string? InitialChargeId { get; set; }
    [Inject] private IPayChanguClient PayChanguClient { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;

    private readonly PayoutLookupRequest request = new();
    private BankPayoutTransaction? transaction;
    private string? errorMessage;
    private bool isLoading;

    protected override void OnInitialized() => request.ChargeId = InitialChargeId ?? string.Empty;

    private async Task GetDetailsAsync(PayoutLookupRequest model)
    {
        transaction = null;
        errorMessage = null;
        isLoading = true;
        try
        {
            var response = await PayChanguClient.Payouts.Bank.GetDetailsAsync(model.ChargeId.Trim());
            if (!response.Success || response.Result?.Data is not { } data)
                errorMessage = response.ErrorMessage ?? "Unable to retrieve bank payout details.";
            else
                transaction = data;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to retrieve bank payout details: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Close() => DialogService.Close();

    public sealed class PayoutLookupRequest
    {
        public string ChargeId { get; set; } = string.Empty;
    }
}