@page "/payouts/bank/details"

<PageTitle>Single Bank Payout Details | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Single Bank Payout Details</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Retrieve details for an individual bank payout using its charge identifier.
        </RadzenText>
    </div>
    <RadzenCard>
        <RadzenTemplateForm TItem="PayoutLookupRequest" Data="@request" Submit="@OpenDetailsDialogAsync">
            <RadzenStack Gap="1rem">
                <div>
                    <RadzenText TextStyle="TextStyle.Subtitle2">Payout charge identifier</RadzenText>
                    <RadzenTextBox Name="ChargeId" @bind-Value="request.ChargeId" Placeholder="Enter payout charge ID" Style="width: 100%" />
                    <RadzenRequiredValidator Component="ChargeId" Text="Enter a payout charge identifier." />
                </div>
                <RadzenButton Text="Get payout details" Icon="search" ButtonType="ButtonType.Submit" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "charge_id")]
    public string? ChargeId { get; set; }

    private readonly PayoutLookupRequest request = new();

    protected override void OnParametersSet() => request.ChargeId = ChargeId ?? string.Empty;

    private async Task OpenDetailsDialogAsync(PayoutLookupRequest model)
    {
        await DialogService.OpenAsync<SingleBankPayoutDetailsDialog>(
            "Single Bank Payout Details",
            new Dictionary<string, object?> { { nameof(SingleBankPayoutDetailsDialog.ChargeId), model.ChargeId.Trim() } },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });
    }

    public sealed class PayoutLookupRequest
    {
        public string ChargeId { get; set; } = string.Empty;
    }
}