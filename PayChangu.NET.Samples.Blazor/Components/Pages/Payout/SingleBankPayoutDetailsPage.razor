@page "/payouts/bank/details"

<PageTitle>Single Bank Payout Details | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Single Bank Payout Details</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Retrieve details for an individual bank payout using its charge identifier.
        </RadzenText>
    </div>
    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenText>Retrieve a single bank payout from PayChangu. The payout charge identifier can be prefilled from the URL using the charge_id query parameter.</RadzenText>
            <RadzenButton Text="Get payout details" Icon="search" Click="@OpenDetailsDialogAsync" />
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "charge_id")]
    public string? ChargeId { get; set; }

    private async Task OpenDetailsDialogAsync()
    {
        await DialogService.OpenAsync<SingleBankPayoutDetailsDialog>(
            "Single Bank Payout Details",
            new Dictionary<string, object?> { { nameof(SingleBankPayoutDetailsDialog.InitialChargeId), ChargeId } },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });
    }
}