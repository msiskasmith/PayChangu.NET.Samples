@using Bogus

@page "/payouts/mobile-money"

<PageTitle>Mobile Money Payout | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Mobile Money Payout</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">Send funds to a Mobile Money wallet using a supported withdrawal operator.</RadzenText>
    </div>

    <RadzenCard>
        <RadzenTemplateForm TItem="InitiateMobileMoneyPayoutRequest" Data="@Request" Submit="@InitiatePayoutAsync">
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                        <RadzenNumeric Name="Amount" TValue="decimal" @bind-Value="Request.Amount" Min="1" Format="N2" Style="width: 100%" />
                        <RadzenNumericRangeValidator Component="Amount" Min="1" Text="Enter an amount greater than zero." />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                        <RadzenDropDown Name="Currency" TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency"
                                        Change="@OnCurrencyChanged" Style="width: 100%" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenText TextStyle="TextStyle.Subtitle2">Mobile Money operator</RadzenText>
                <a href="/payouts/operators">View payout operators</a>
                <RadzenDropDown Name="MobileMoneyOperatorRefId" TValue="string" Data="@mobileMoneyOperators"
                                TextProperty="Name" ValueProperty="RefId" @bind-Value="Request.MobileMoneyOperatorRefId"
                                Change="@OnOperatorChanged" Placeholder="Select an operator"
                                Disabled="@isLoadingReferenceData" Style="width: 100%" />
                <RadzenRequiredValidator Component="MobileMoneyOperatorRefId" Text="Select a payout operator." />
                @if (isLoadingReferenceData)
                {
                    <RadzenText TextStyle="TextStyle.Caption">Loading payout operators...</RadzenText>
                }
                else if (!string.IsNullOrWhiteSpace(referenceDataError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning">@referenceDataError</RadzenAlert>
                }

                <RadzenTextBox Name="Mobile" @bind-Value="Request.Mobile" Placeholder="Recipient mobile number" Style="width: 100%" />
                <RadzenRequiredValidator Component="Mobile" Text="Enter the recipient's mobile number." />

                <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Recipient details (optional)</RadzenText>
                    <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" ButtonType="ButtonType.Button" Click="@GenerateTestDetails" />
                </div>
                <RadzenText TextStyle="TextStyle.Caption">Generated values are editable.</RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="Request.FirstName" Placeholder="First name" Style="width: 100%" /></RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="Request.LastName" Placeholder="Last name" Style="width: 100%" /></RadzenColumn>
                    <RadzenColumn Size="12">
                        <RadzenTextBox Name="Email" @bind-Value="Request.Email" Placeholder="Email address" Style="width: 100%" />
                        <RadzenEmailValidator Component="Email" Text="Enter a valid email address." />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenButton Text="Initiate Mobile Money payout" Icon="send" ButtonType="ButtonType.Submit" Disabled="@isLoadingReferenceData" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private IPayChanguClient payChanguClient { get; set; } = default!;
    [Inject] private DialogService dialogService { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly List<SupportedMobileMoneyOperator> mobileMoneyOperators = [];
    private InitiateMobileMoneyPayoutRequest Request { get; set; } = new() { Amount = 5000m };
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private string? referenceDataError;
    private bool isLoadingReferenceData;

    protected override async Task OnInitializedAsync()
    {
        await LoadMobileMoneyOperatorsAsync();
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        Request.FirstName = faker.Name.FirstName();
        Request.LastName = faker.Name.LastName();
        Request.Email = faker.Internet.Email();
        Request.Mobile = GetTestMobileNumber(Request.MobileMoneyOperatorRefId);
    }

    private void OnOperatorChanged(object value)
    {
        Request.MobileMoneyOperatorRefId = value?.ToString() ?? string.Empty;
        Request.Mobile = GetTestMobileNumber(Request.MobileMoneyOperatorRefId);
    }

    private string GetTestMobileNumber(string? operatorRefId)
    {
        var operatorName = mobileMoneyOperators.FirstOrDefault(x => x.RefId == operatorRefId)?.Name ?? string.Empty;
        if (operatorName.Contains("TNM", StringComparison.OrdinalIgnoreCase)) return "0888000000";
        if (operatorName.Contains("Airtel", StringComparison.OrdinalIgnoreCase)) return "0999000000";
        return faker.Random.ReplaceNumbers("09########");
    }

    private async Task OnCurrencyChanged(object value)
    {
        currency = (PayChanguCurrency)value;
        await LoadMobileMoneyOperatorsAsync();
    }

    private async Task LoadMobileMoneyOperatorsAsync()
    {
        isLoadingReferenceData = true;
        referenceDataError = null;
        try
        {
            var response = await payChanguClient.ReferenceData.MobileMoneyOperators.GetAllAsync();
            if (response.Success && response.Result?.Data is { } operators)
            {
                mobileMoneyOperators.Clear();
                mobileMoneyOperators.AddRange(operators.Where(x =>
                    x.SupportsWithdrawals &&
                    string.Equals(x.SupportedCountry.Currency, currency.ToString(), StringComparison.OrdinalIgnoreCase)));

                if (!mobileMoneyOperators.Any(x => x.RefId == Request.MobileMoneyOperatorRefId))
                {
                    Request.MobileMoneyOperatorRefId = mobileMoneyOperators.FirstOrDefault()?.RefId ?? string.Empty;
                }
                Request.Mobile = GetTestMobileNumber(Request.MobileMoneyOperatorRefId);
            }
            else
            {
                referenceDataError = response.ErrorMessage ?? "Unable to retrieve Mobile Money payout operators.";
            }
        }
        catch (HttpRequestException ex)
        {
            referenceDataError = $"Unable to retrieve payout operators: {ex.Message}";
        }
        finally
        {
            isLoadingReferenceData = false;
        }
    }

    private async Task InitiatePayoutAsync(InitiateMobileMoneyPayoutRequest request)
    {
        Request.ChargeId = Guid.CreateVersion7().ToString();
        await dialogService.OpenAsync<MobileMoneyPayoutDialog>(
            "Initiate Mobile Money Payout",
            new Dictionary<string, object?> { { nameof(MobileMoneyPayoutDialog.Request), Request } },
            new DialogOptions { Width = "600px" });

        GenerateTestDetails();
    }
}
