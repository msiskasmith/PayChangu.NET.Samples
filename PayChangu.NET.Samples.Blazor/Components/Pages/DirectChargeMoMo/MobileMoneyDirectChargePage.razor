@using Bogus

@page "/direct-charge/mobile-money"

<PageTitle>Mobile Money Direct Charge | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Direct Charge — Mobile Money</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">Request a payment from a customer's Mobile Money wallet.</RadzenText>
    </div>

    <RadzenCard>
        <RadzenTemplateForm TItem="InitiateMobileMoneyDirectChargeRequest" Data="@Request" Submit="@InitiateDirectChargeAsync">
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                        <RadzenNumeric Name="Amount" TValue="decimal" @bind-Value="Request.Amount" Min="1" Format="N2" Style="width: 100%" />
                        <RadzenNumericRangeValidator Component="Amount" Min="1" Text="Enter an amount greater than zero." />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Mobile Money operator</RadzenText>
                        <RadzenDropDown Name="MobileMoneyOperatorRefId" TValue="string" Data="@mobileMoneyOperators"
                                        TextProperty="Name" ValueProperty="RefId"
                                        @bind-Value="Request.MobileMoneyOperatorRefId" Change="@OnOperatorChanged"
                                        Placeholder="Select an operator" Disabled="@isLoadingOperators" Style="width: 100%" />
                        <RadzenRequiredValidator Component="MobileMoneyOperatorRefId" Text="Select a Mobile Money operator." />
                        <a href="/direct-charge/mobile-money/operators">View supported operators</a>
                        @if (isLoadingOperators)
                        {
                            <RadzenText TextStyle="TextStyle.Caption">Loading supported operators...</RadzenText>
                        }
                        else if (!string.IsNullOrWhiteSpace(operatorErrorMessage))
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning">@operatorErrorMessage</RadzenAlert>
                        }
                    </RadzenColumn>
                </RadzenRow>
                <RadzenText TextStyle="TextStyle.Caption">The currency for Mobile Money Direct Charge is determined by the selected operator.</RadzenText>

                <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Customer details</RadzenText>
                    <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" ButtonType="ButtonType.Button" Click="@GenerateTestDetails" />
                </div>
                <RadzenText TextStyle="TextStyle.Caption">Generated values are editable. TNM and Airtel use the documented sandbox numbers.</RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenTextBox Name="Mobile" @bind-Value="Request.Mobile" Placeholder="Mobile number" Style="width: 100%" />
                        <RadzenRequiredValidator Component="Mobile" Text="Enter the customer's mobile number." />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenTextBox Name="Email" @bind-Value="Request.Email" Placeholder="Email address (optional)" Style="width: 100%" />
                        <RadzenEmailValidator Component="Email" Text="Enter a valid email address." />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenTextBox Name="FirstName" @bind-Value="Request.FirstName" Placeholder="First name (optional)" Style="width: 100%" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenTextBox Name="LastName" @bind-Value="Request.LastName" Placeholder="Last name (optional)" Style="width: 100%" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenButton Text="Charge Mobile Money" Icon="payments" ButtonType="ButtonType.Submit" Disabled="@isLoadingOperators" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private DialogService dialogService { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly List<SupportedMobileMoneyOperator> mobileMoneyOperators = [];
    private InitiateMobileMoneyDirectChargeRequest Request { get; set; } = new() { Amount = 5000m };
    private string? operatorErrorMessage;
    private bool isLoadingOperators;

    protected override async Task OnInitializedAsync()
    {
        await LoadMobileMoneyOperatorsAsync();
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        Request.FirstName = faker.Name.FirstName();
        Request.LastName = faker.Name.LastName();
        Request.Email = faker.Internet.Email();
        Request.Mobile = GetTestMobileNumber(Request.MobileMoneyOperatorRefId);
    }

    private void OnOperatorChanged(object value)
    {
        Request.MobileMoneyOperatorRefId = value?.ToString() ?? string.Empty;
        Request.Mobile = GetTestMobileNumber(Request.MobileMoneyOperatorRefId);
    }

    private string GetTestMobileNumber(string? operatorRefId)
    {
        var operatorName = mobileMoneyOperators.FirstOrDefault(x => x.RefId == operatorRefId)?.Name ?? string.Empty;
        if (operatorName.Contains("TNM", StringComparison.OrdinalIgnoreCase)) return "0888000000";
        if (operatorName.Contains("Airtel", StringComparison.OrdinalIgnoreCase)) return "0999000000";
        return faker.Random.ReplaceNumbers("09########");
    }

    private async Task LoadMobileMoneyOperatorsAsync()
    {
        isLoadingOperators = true;
        operatorErrorMessage = null;
        try
        {
            var response = await PayChanguClient.ReferenceData.MobileMoneyOperators.GetAllAsync();
            if (response.Success && response.Result?.Data is { } operators)
            {
                mobileMoneyOperators.AddRange(operators);
                Request.MobileMoneyOperatorRefId = mobileMoneyOperators.FirstOrDefault()?.RefId ?? string.Empty;
            }
            else
            {
                operatorErrorMessage = response.ErrorMessage ?? "Unable to retrieve supported Mobile Money operators.";
            }
        }
        catch (HttpRequestException ex)
        {
            operatorErrorMessage = $"Unable to retrieve Mobile Money operators: {ex.Message}";
        }
        finally
        {
            isLoadingOperators = false;
        }
    }

    [Inject] private IPayChanguClient PayChanguClient { get; set; } = default!;

    private async Task InitiateDirectChargeAsync(InitiateMobileMoneyDirectChargeRequest request)
    {
        Request.ChargeId = Guid.CreateVersion7().ToString();
        await dialogService.OpenAsync<MobileMoneyDirectChargeDialog>(
            "Initiate Mobile Money Direct Charge",
            new Dictionary<string, object?> { { nameof(MobileMoneyDirectChargeDialog.Request), Request } },
            new DialogOptions { Width = "600px" });

        GenerateTestDetails();
    }
}
