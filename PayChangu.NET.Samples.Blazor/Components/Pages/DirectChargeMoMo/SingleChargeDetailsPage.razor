@page "/direct-charge/mobile-money/details"

<PageTitle>Single Charge Details | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Single Mobile Money Charge Details</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Retrieve the details of a Mobile Money Direct Charge using its charge identifier.
        </RadzenText>
    </div>
    <RadzenCard>
        <RadzenTemplateForm TItem="ChargeLookupRequest" Data="@request" Submit="@OpenDetailsDialogAsync">
            <RadzenStack Gap="1rem">
                <div>
                    <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
                    <RadzenTextBox Name="ChargeId" @bind-Value="request.ChargeId" Placeholder="Enter charge ID" Style="width: 100%" />
                    <RadzenRequiredValidator Component="ChargeId" Text="Enter a charge identifier." />
                </div>
                <RadzenButton Text="Get charge details" Icon="search" ButtonType="ButtonType.Submit" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "charge_id")]
    public string? ChargeId { get; set; }

    private readonly ChargeLookupRequest request = new();

    protected override void OnParametersSet() => request.ChargeId = ChargeId ?? string.Empty;

    private async Task OpenDetailsDialogAsync(ChargeLookupRequest model)
    {
        await DialogService.OpenAsync<SingleMobileMoneyChargeDetailsDialog>(
            "Single Mobile Money Charge Details",
            new Dictionary<string, object?> { { nameof(SingleMobileMoneyChargeDetailsDialog.ChargeId), model.ChargeId.Trim() } },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false });
    }

    public sealed class ChargeLookupRequest
    {
        public string ChargeId { get; set; } = string.Empty;
    }
}