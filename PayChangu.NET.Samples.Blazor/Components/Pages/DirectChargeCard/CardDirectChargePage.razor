@using Bogus

@page "/direct-charge/card"

<PageTitle>Card Direct Charge | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Direct Card Charge</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">Initiate a card charge and complete the bank's 3-D Secure authentication.</RadzenText>
    </div>

    <RadzenAlert AlertStyle="AlertStyle.Warning">
        <strong>PCI DSS requirement:</strong> PayChangu requires your business to be PCI DSS compliant before processing direct card charges.
        PayChangu must also activate Card Direct Charge on your account. Do not use this form for real card details unless your environment meets those requirements.
    </RadzenAlert>

    <RadzenCard>
        <RadzenTemplateForm TItem="InitiateCardDirectChargeRequest" Data="@Request" Submit="@InitiateCardDirectChargeAsync">
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                        <RadzenNumeric Name="Amount" TValue="decimal" @bind-Value="Request.Amount" Min="1" Format="N2" Style="width: 100%" />
                        <RadzenNumericRangeValidator Component="Amount" Min="1" Text="Enter an amount greater than zero." />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                        <RadzenDropDown Name="Currency" TValue="PayChanguCurrency" Data="@currencies" @bind-Value="Request.Currency" Style="width: 100%" />
                    </RadzenColumn>
                </RadzenRow>

                <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Customer details</RadzenText>
                    <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" ButtonType="ButtonType.Button" Click="@GenerateTestDetails" />
                </div>
                <RadzenTextBox Name="Email" @bind-Value="Request.Email" Placeholder="Email address (optional)" Style="width: 100%" />
                <RadzenEmailValidator Component="Email" Text="Enter a valid email address." />

                <RadzenText TextStyle="TextStyle.Subtitle2">PayChangu sandbox test cards</RadzenText>
                <RadzenDropDown TValue="string" Data="@testCards" TextProperty="Label" ValueProperty="CardNumber"
                                @bind-Value="selectedTestCardNumber" Placeholder="Select a test card to autofill" Style="width: 100%" />
                <RadzenText TextStyle="TextStyle.Caption">
                    These test cards only work with PayChangu test API keys. All use expiry 12/30 and CVV 123.
                    The 3-D Secure OTP is 1234. Do not use test card details with live credentials.
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Card details</RadzenText>
                <RadzenTextBox Name="CardholderName" @bind-Value="Request.CardholderName" Placeholder="Name on card" Style="width: 100%" />
                <RadzenRequiredValidator Component="CardholderName" Text="Enter the name on the card." />
                <RadzenTextBox Name="CardNumber" @bind-Value="Request.CardNumber" Placeholder="Card number" Style="width: 100%" />
                <RadzenRequiredValidator Component="CardNumber" Text="Enter the card number." />
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenTextBox Name="Expiry" @bind-Value="Request.Expiry" Placeholder="Expiry (MM/YY)" Style="width: 100%" />
                        <RadzenRequiredValidator Component="Expiry" Text="Enter the card expiry." />
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenTextBox Name="Cvv" @bind-Value="Request.Cvv" Type="password" Placeholder="CVV" Style="width: 100%" />
                        <RadzenRequiredValidator Component="Cvv" Text="Enter the card CVV." />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenText TextStyle="TextStyle.Subtitle2">3-D Secure return URL</RadzenText>
                <RadzenTextBox Name="RedirectUrl" @bind-Value="Request.RedirectUrl" Placeholder="Public URL ending in /card-payment-return" Style="width: 100%" />
                <RadzenRequiredValidator Component="RedirectUrl" Text="Provide a 3-D Secure return URL." />
                <RadzenText TextStyle="TextStyle.Caption">This URL must be publicly accessible over HTTPS. For local testing, use your tunnel URL.</RadzenText>
                <RadzenButton Text="Charge card" Icon="credit_card" ButtonType="ButtonType.Submit" />
            </RadzenStack>
        </RadzenTemplateForm>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] private DialogService dialogService { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly TestCard[] testCards =
    [
        new("Visa — 3DS Success", "4242424242424242"),
        new("Visa — 3DS Timeout", "4000000000003220"),
        new("Visa — 3DS Insufficient", "4000000000009995"),
        new("Visa — 3DS Declined", "4000000000000002"),
        new("Mastercard — 3DS Success", "5555555555554444"),
        new("Mastercard — 3DS Error", "5200000000000008")
    ];

    private InitiateCardDirectChargeRequest Request { get; set; } = new() { Amount = 5000m, Currency = PayChanguCurrency.MWK };
    private string? _selectedTestCardNumber;
    private string? selectedTestCardNumber
    {
        get => _selectedTestCardNumber;
        set
        {
            _selectedTestCardNumber = value;
            var testCard = testCards.FirstOrDefault(card => card.CardNumber == value);
            if (testCard is not null)
            {
                Request.CardNumber = testCard.CardNumber;
                Request.Expiry = "12/30";
                Request.Cvv = "123";
                Request.CardholderName = faker.Name.FullName();
            }
        }
    }

    protected override void OnInitialized() => GenerateTestDetails();

    private void GenerateTestDetails()
    {
        Request.Email = faker.Internet.Email();
        Request.CardholderName = faker.Name.FullName();
    }

    private async Task InitiateCardDirectChargeAsync(InitiateCardDirectChargeRequest request)
    {
        Request.ChargeId = Guid.CreateVersion7().ToString();
        await dialogService.OpenAsync<CardDirectChargeDialog>(
            "Initiate Card Direct Charge",
            new Dictionary<string, object?> { { nameof(CardDirectChargeDialog.Request), Request } },
            new DialogOptions { Width = "600px" });

        // Clear sensitive card details after the dialog closes.
        Request.CardNumber = string.Empty;
        Request.Expiry = string.Empty;
        Request.Cvv = string.Empty;
        _selectedTestCardNumber = null;
    }

    private sealed record TestCard(string Label, string CardNumber);
}
